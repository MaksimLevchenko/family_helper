  smtpFromEmail: ''
  smtpFromName: 'Family Helper'
  smtpUseSsl: ''
  smtpAllowInsecure: 'false'
  firebaseServiceAccountJson: ''
  firebaseServiceAccountJsonPath: './firebase-service-account.json'

